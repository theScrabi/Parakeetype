    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Aktivizēšanas režīms</string>
    <string name="pref_trigger_mode_subtitle">Kā sākt un apturēt balss ierakstīšanu.</string>
    <string name="pref_trigger_hold">Turēt, lai runātu</string>
    <string name="pref_trigger_tap_toggle">Pieskarties, lai pārslēgtu</string>
    <string name="pref_instant_mode_title">Tūlītējais režīms</string>
    <string name="pref_instant_mode_subtitle">Sāk klausīties, tiklīdz pārslēdzaties uz Parakeetype, piem., ar citas tastatūras mikrofona taustiņu. Kad beidzat runāt, teksts tiek ievadīts un notiek pārslēgšanās atpakaļ uz šo tastatūru. Lai paliktu Parakeetype, sesijas laikā pieskarieties runāšanas pogai.</string>
    <string name="pref_delete_title">Dzēšanas poga</string>
    <string name="pref_delete_subtitle">Ko dzēš tastatūras atkritnes poga. „Pēdējais teikums“ noņem tikai pēdējo teikumu pirms kursora, lai garš dokuments nekad netiktu nejauši izdzēsts.</string>
    <string name="pref_delete_all">Viss teksts</string>
    <string name="pref_delete_last_sentence">Pēdējais teikums</string>
    <string name="pref_position_title">Tastatūras novietojums</string>
    <string name="pref_position_subtitle">Kur atrodas tastatūras vadīklas. Pa kreisi vai pa labi tās var sasniegt ar vienu īkšķi — noderīgi ainavas orientācijā, kreiļiem un planšetdatoros.</string>
    <string name="pref_position_portrait">Portreta orientācijā</string>
    <string name="pref_position_landscape">Ainavas orientācijā</string>
    <string name="pref_position_left">Pa kreisi</string>
    <string name="pref_position_center">Centrā</string>
    <string name="pref_position_right">Pa labi</string>
    <string name="pref_vad_title">Balss aktivitātes noteikšana (VAD)</string>
    <string name="pref_vad_subtitle">Izmanto Silero VAD, lai pirms transkripcijas atfiltrētu klusumu un fona troksni. Atspējojiet tikai tad, ja VAD nogriež jūsu runas sākumu vai sniedz tukšus rezultātus.</string>
    <string name="pref_postprocessing_title">Transkripta pēcapstrāde</string>
    <string name="pref_postprocessing_subtitle">Noņem pildvārdus (ē, ēm, hmm), apvieno stostīšanos un notīra atkārtotas frāzes, ko modelis dažkārt halucinē. Atspējojiet, lai saņemtu precīzu, neapstrādātu modeļa izvadi — noderīgi, lai noskaidrotu, vai tīrīšana ir vainojama izlaistos vai mainītos vārdos.</string>
    <string name="pref_postprocessing_disabled_raw">Atspējota (neapstrādāta izvade)</string>
    <string name="pref_keep_loaded_title">Paturēt modeli ielādētu</string>
    <string name="pref_keep_loaded_subtitle">Patur runas modeli atmiņā, kamēr izmantojat citu tastatūru, lai diktēšana būtu uzreiz gatava, kad pārslēdzaties atpakaļ, un modelis nebūtu jāielādē no jauna. Darbojas kā priekšplāna pakalpojums ar pastāvīgu paziņojumu un aizņem aptuveni 700 MB RAM.</string>
    <string name="pref_diagnostics_title">Konveijera diagnostika</string>
    <string name="pref_diagnostics_subtitle">Rāda tastatūrā tiešraides emblēmu ar loga apgriešanas, līdzinājuma atkopšanas un atmesto tukšo soļu skaitītājiem. Noderīgi konveijera problēmu diagnosticēšanai; pēc noklusējuma izslēgta.</string>
    <string name="pref_diagnostics_visible">Redzama</string>
    <string name="pref_diagnostics_hidden">Paslēpta</string>

    <!-- Model screen -->
    <string name="model_screen_title">Runas atpazīšanas modeļi</string>
    <string name="model_screen_subtitle">Instalējiet modeli un pieskarieties „Iestatīt kā aktīvu“, lai to izmantotu transkripcijai. Vienlaikus tiek ielādēts tikai viens modelis. Lietotnei Parakeetype nav piekļuves internetam: modeļa failu lejupielādējiet pārlūkā un importējiet šeit.</string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktīvais modelis</string>
    <string name="dialog_delete_title">Apstiprināt dzēšanu</string>
    <string name="dialog_delete_message">Vai tiešām vēlaties dzēst šo modeli? Šo darbību nevar atsaukt.</string>
    <string name="model_install_explanation">1. Lejupielādējiet modeļa failu (~%d MB, viens ZIP arhīvs) pārlūkā.\n2. Pieskarieties „Importēt modeļa failu“ un atlasiet lejupielādēto arhīvu.\nPēc importēšanas arhīvu varat izdzēst no mapes Lejupielādes.</string>

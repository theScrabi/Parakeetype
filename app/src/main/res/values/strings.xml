    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Trigger Mode</string>
    <string name="pref_trigger_mode_subtitle">How to start and stop voice recording.</string>
    <string name="pref_trigger_hold">Hold to Talk</string>
    <string name="pref_trigger_tap_toggle">Tap to Toggle</string>
    <string name="pref_immediate_mode_title">Immediate Mode</string>
    <string name="pref_immediate_mode_subtitle">Starts listening as soon as you switch to Parakeetype, e.g. with the
        microphone key of another keyboard. Once you stop speaking, the text is typed and you are switched back to that
        keyboard.</string>
    <string name="pref_delete_title">Delete Button</string>
    <string name="pref_delete_subtitle">What the trash button on the keyboard deletes. \"Last Sentence\" removes only the
        most recent sentence before the cursor, so a long document is never wiped by accident.
    </string>
    <string name="pref_delete_all">All Text</string>
    <string name="pref_delete_last_sentence">Last Sentence</string>
    <string name="pref_position_title">Keyboard Position</string>
    <string name="pref_position_subtitle">Where the keyboard controls sit. Left or right keeps them within reach of one
        thumb — useful in landscape, for left-handed use and on tablets.
    </string>
    <string name="pref_position_portrait">In portrait</string>
    <string name="pref_position_landscape">In landscape</string>
    <string name="pref_position_left">Left</string>
    <string name="pref_position_center">Center</string>
    <string name="pref_position_right">Right</string>
    <string name="pref_vad_title">Voice Activity Detection (VAD)</string>
    <string name="pref_vad_subtitle">Uses Silero VAD to filter out silence and background noise before transcription.
        Disable only if VAD is cutting off the start of your speech or producing empty results.
    </string>
    <string name="pref_postprocessing_title">Transcript Post-Processing</string>
    <string name="pref_postprocessing_subtitle">Removes filler words (uh, um, hmm), collapses stutters, and cleans up
        repeated phrases the model sometimes hallucinates. Disable to receive the exact raw model output - useful for
        diagnosing whether cleaning is responsible for dropped or altered words.
    </string>
    <string name="pref_postprocessing_disabled_raw">Disabled (raw output)</string>
    <string name="pref_keep_loaded_title">Keep Model Loaded</string>
    <string name="pref_keep_loaded_subtitle">Keeps the speech model in memory while you use another keyboard, so
        dictation is ready instantly when you switch back instead of reloading the model. Runs a foreground service with
        a persistent notification and keeps about 700 MB of RAM in use.
    </string>
    <string name="pref_diagnostics_title">Pipeline Diagnostics</string>
    <string name="pref_diagnostics_subtitle">Shows a live badge on the keyboard with counters for window trims,
        alignment recoveries, and discarded blank strides. Useful for diagnosing pipeline issues; off by default.
    </string>
    <string name="pref_diagnostics_visible">Visible</string>
    <string name="pref_diagnostics_hidden">Hidden</string>


    <string name="pref_mic_subtitle">Calibrate to pick the clearest mic for short words like \"Thanks\".</string>
    <string name="pref_mic_calibrate">Calibrate microphones</string>
    <string name="pref_raw_mic_title">Raw microphone (no echo cancellation)</string>
    <string name="pref_raw_mic_subtitle">Bypasses the platform\'s echo cancellation and noise suppression. Enable this when
        transcribing audio that plays from the device\'s own speaker (e.g. a voicemail on speakerphone) - with the default
        source the speaker signal is cancelled out of the microphone and transcribes as silence. Slightly less clean
        capture in noisy rooms.
    </string>

    <!-- Microphone calibration -->
    <string name="calib_subtitle">Pick the microphone that captures the clearest high-frequency detail. The speech model needs it to resolve short words like \"Thanks\".</string>

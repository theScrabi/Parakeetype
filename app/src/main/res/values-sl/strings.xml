    <string name="pref_mic_title">Mikrofon</string>
    <string name="pref_mic_subtitle">Umerite, da izberete najjasnejši mikrofon za kratke besede, kot je „Thanks“.</string>
    <string name="pref_mic_calibrate">Umeri mikrofone</string>
    <string name="pref_raw_mic_title">Neobdelan mikrofon (brez odpravljanja odmeva)</string>
    <string name="pref_raw_mic_subtitle">Zaobide sistemsko odpravljanje odmeva in zmanjševanje šuma. Omogočite, ko prepisujete zvok, ki se predvaja iz zvočnika same naprave (npr. glasovno pošto prek zvočnika) – s privzetim virom se signal zvočnika odstrani iz mikrofona in se prepiše kot tišina. V hrupnih prostorih je zajem nekoliko manj čist.</string>

    <!-- Microphone calibration -->
    <string name="calib_subtitle">Izberite mikrofon, ki najjasneje zajame visoke frekvence. Govorni model jih potrebuje za prepoznavanje kratkih besed, kot je „Thanks“.</string>
    <string name="calib_instructions">Pri vsakem mikrofonu počakajte na rdeči indikator in nato razločno recite angleško besedo „thanks“. Najjasnejši mikrofon se izbere samodejno.</string>

    <string name="pref_immediate_mode_title">Takojšnji način</string>
    <string name="pref_immediate_mode_subtitle">Začne poslušati takoj, ko preklopite na Parakeetype, npr. s tipko za mikrofon druge tipkovnice. Ko nehate govoriti, se besedilo vnese in preklopite nazaj na tisto tipkovnico.</string>
    <string name="pref_delete_title">Gumb za brisanje</string>
    <string name="pref_delete_subtitle">Kaj izbriše gumb s košem na tipkovnici. „Zadnji stavek“ odstrani samo zadnji stavek pred kazalcem, tako da dolgega dokumenta nikoli ne izbrišete po nesreči.</string>
    <string name="pref_delete_all">Vse besedilo</string>
    <string name="pref_delete_last_sentence">Zadnji stavek</string>
    <string name="pref_position_title">Položaj tipkovnice</string>
    <string name="pref_position_subtitle">Kje so kontrolniki tipkovnice. Levo ali desno so na dosegu enega palca – uporabno v ležečem načinu, za levičarje in na tablicah.</string>
    <string name="pref_position_portrait">V pokončnem načinu</string>
    <string name="pref_position_landscape">V ležečem načinu</string>
    <string name="pref_position_left">Levo</string>
    <string name="pref_position_center">Sredina</string>
    <string name="pref_position_right">Desno</string>
    <string name="pref_vad_title">Zaznavanje glasovne aktivnosti (VAD)</string>
    <string name="pref_vad_subtitle">Uporablja Silero VAD, da pred prepisom odstrani tišino in hrup v ozadju. Onemogočite samo, če VAD odreže začetek vašega govora ali vrača prazne rezultate.</string>
    <string name="pref_postprocessing_title">Naknadna obdelava prepisa</string>
    <string name="pref_postprocessing_subtitle">Odstrani mašila (eee, hm, mhm), združi jecljanje in počisti ponovljene besedne zveze, ki si jih model včasih izmisli. Onemogočite, če želite prejeti natančen neobdelan izhod modela – uporabno za ugotavljanje, ali čiščenje povzroča izpuščene ali spremenjene besede.</string>
    <string name="pref_postprocessing_disabled_raw">Onemogočeno (neobdelan izhod)</string>
    <string name="pref_keep_loaded_title">Ohrani model naložen</string>
    <string name="pref_keep_loaded_subtitle">Ohrani govorni model v pomnilniku, medtem ko uporabljate drugo tipkovnico, tako da je narekovanje takoj pripravljeno, ko preklopite nazaj, in modela ni treba znova nalagati. Deluje kot storitev v ospredju s stalnim obvestilom in zaseda približno 700 MB pomnilnika RAM.</string>
    <string name="pref_diagnostics_title">Diagnostika obdelave</string>
    <string name="pref_diagnostics_subtitle">Na tipkovnici prikaže značko v živo s števci obrezovanj okna, obnovitev poravnave in zavrženih praznih korakov. Uporabno za diagnosticiranje težav z obdelavo; privzeto skrito.</string>
    <string name="pref_diagnostics_visible">Prikazano</string>
    <string name="pref_diagnostics_hidden">Skrito</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modeli za prepoznavanje govora</string>
    <string name="model_screen_subtitle">Namestite model in se dotaknite „Nastavi kot aktivnega“, da ga uporabite za prepis. Naenkrat je naložen samo en model. Parakeetype nima dostopa do interneta: datoteko modela prenesete v brskalniku in jo uvozite tukaj.</string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktivni model</string>
    <string name="dialog_delete_title">Potrdite brisanje</string>
    <string name="dialog_delete_message">Ali res želite izbrisati ta model? Tega dejanja ni mogoče razveljaviti.</string>
    <string name="model_install_explanation">1. V brskalniku prenesite datoteko modela (~%d MB, en arhiv ZIP).\n2. Dotaknite se „Uvozi datoteko modela“ in izberite preneseni arhiv.\nPo uvozu lahko arhiv izbrišete iz mape Prenosi.</string>

    <string name="model_active_label">Aktiivinen malli</string>
    <string name="dialog_delete_title">Vahvista poistaminen</string>
    <string name="dialog_delete_message">Haluatko varmasti poistaa tämän mallin? Toimintoa ei voi kumota.</string>
    <string name="model_install_explanation">1. Lataa mallitiedosto (~%d Mt, yksi ZIP-arkisto) selaimella.\n2. Napauta ”Tuo mallitiedosto” ja valitse ladattu arkisto.\nTuonnin jälkeen voit poistaa arkiston Lataukset-kansiosta.</string>

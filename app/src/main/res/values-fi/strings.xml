    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Käynnistystapa</string>
    <string name="pref_trigger_mode_subtitle">Miten puheen tallennus aloitetaan ja lopetetaan.</string>
    <string name="pref_trigger_hold">Puhu pitämällä painettuna</string>
    <string name="pref_trigger_tap_toggle">Vaihda napauttamalla</string>
    <string name="pref_instant_mode_title">Välitön tila</string>
    <string name="pref_instant_mode_subtitle">Alkaa kuunnella heti, kun vaihdat Parakeetype-näppäimistöön, esim. toisen näppäimistön mikrofonipainikkeella, ja lopettaa, kun lopetat puhumisen. Näppäimistö pysyy auki, joten voit jatkaa muokkaamista tai sanelua.</string>
    <string name="pref_delete_title">Poistopainike</string>
    <string name="pref_delete_subtitle">Mitä näppäimistön roskakoripainike poistaa. ”Viimeinen lause” poistaa vain kohdistinta edeltävän viimeisimmän lauseen, joten pitkä asiakirja ei koskaan pyyhkiydy vahingossa.</string>
    <string name="pref_delete_all">Kaikki teksti</string>
    <string name="pref_delete_last_sentence">Viimeinen lause</string>
    <string name="pref_position_title">Näppäimistön sijainti</string>
    <string name="pref_position_subtitle">Missä näppäimistön painikkeet ovat. Vasemmalla tai oikealla ne ovat yhden peukalon ulottuvilla – kätevää vaakasuunnassa, vasenkätisille ja tableteilla.</string>
    <string name="pref_position_portrait">Pystysuunnassa</string>
    <string name="pref_position_landscape">Vaakasuunnassa</string>
    <string name="pref_position_left">Vasen</string>
    <string name="pref_position_center">Keskellä</string>
    <string name="pref_position_right">Oikea</string>
    <string name="pref_vad_title">Puheaktiivisuuden tunnistus (VAD)</string>
    <string name="pref_vad_subtitle">Suodattaa Silero VAD:n avulla hiljaisuuden ja taustamelun pois ennen litterointia. Poista käytöstä vain, jos VAD leikkaa puheesi alun pois tai tuottaa tyhjiä tuloksia.</string>
    <string name="pref_postprocessing_title">Litteroinnin jälkikäsittely</string>
    <string name="pref_postprocessing_subtitle">Poistaa täytesanat (öö, ömm, hmm), yhdistää änkytykset ja siivoaa toistuvat fraasit, joita malli joskus hallusinoi. Poista käytöstä, jos haluat mallin tarkan raakatulosteen - hyödyllistä, kun selvität, johtuvatko puuttuvat tai muuttuneet sanat siivouksesta.</string>
    <string name="pref_postprocessing_disabled_raw">Ei käytössä (raakatuloste)</string>
    <string name="pref_keep_loaded_title">Pidä malli ladattuna</string>
    <string name="pref_keep_loaded_subtitle">Pitää puhemallin muistissa, kun käytät toista näppäimistöä, jotta sanelu on heti valmis, kun vaihdat takaisin, eikä mallia tarvitse ladata uudelleen. Käyttää etualan palvelua, jolla on pysyvä ilmoitus, ja varaa noin 700 Mt RAM-muistia.</string>
    <string name="pref_diagnostics_title">Putken diagnostiikka</string>
    <string name="pref_diagnostics_subtitle">Näyttää näppäimistöllä reaaliaikaisen merkin, jossa on laskurit ikkunan rajauksille, kohdistuksen palautuksille ja hylätyille tyhjille askelille. Hyödyllinen putken ongelmien selvittämiseen; oletuksena piilotettu.</string>
    <string name="pref_diagnostics_visible">Näkyvissä</string>
    <string name="pref_diagnostics_hidden">Piilotettu</string>

    <!-- Model screen -->
    <string name="model_screen_title">Puheentunnistusmallit</string>
    <string name="model_screen_subtitle">Asenna malli ja napauta ”Aseta aktiiviseksi”, niin voit käyttää sitä litterointiin. Vain yksi malli ladataan kerrallaan. Parakeetypella ei ole internetyhteyttä: lataat mallitiedoston selaimella ja tuot sen tänne.</string>

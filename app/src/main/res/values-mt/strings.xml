    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Mod ta\' Attivazzjoni</string>
    <string name="pref_trigger_mode_subtitle">Kif tibda u twaqqaf ir-reġistrazzjoni tal-vuċi.</string>
    <string name="pref_trigger_hold">Żomm biex Titkellem</string>
    <string name="pref_trigger_tap_toggle">Agħfas biex Taqleb</string>
    <string name="pref_instant_mode_title">Mod Instantanju</string>
    <string name="pref_instant_mode_subtitle">Jibda jisma\' hekk kif taqleb għal Parakeetype, eż. bil-buttuna tal-mikrofonu ta\' tastiera oħra. Meta tieqaf titkellem, it-test jiġi ttajpjat u terġa\' lura għal dik it-tastiera. Mess il-buttuna biex titkellem waqt is-sessjoni biex tibqa\' f\'Parakeetype.</string>
    <string name="pref_delete_title">Buttuna tat-Tħassir</string>
    <string name="pref_delete_subtitle">X\'tħassar il-buttuna tal-iskart fuq it-tastiera. “L-Aħħar Sentenza” tneħħi biss l-aħħar sentenza qabel il-cursor, biex dokument twil qatt ma jitħassar bi żball.</string>
    <string name="pref_delete_all">It-Test Kollu</string>
    <string name="pref_delete_last_sentence">L-Aħħar Sentenza</string>
    <string name="pref_position_title">Pożizzjoni tat-Tastiera</string>
    <string name="pref_position_subtitle">Fejn jinsabu l-kontrolli tat-tastiera. Fuq ix-xellug jew fuq il-lemin jintlaħqu b\'saba\' l-kbir wieħed — utli fl-orjentazzjoni orizzontali, għal min hu xellugi u fuq it-tablets.</string>
    <string name="pref_position_portrait">Fl-orjentazzjoni vertikali</string>
    <string name="pref_position_landscape">Fl-orjentazzjoni orizzontali</string>
    <string name="pref_position_left">Xellug</string>
    <string name="pref_position_center">Nofs</string>
    <string name="pref_position_right">Lemin</string>
    <string name="pref_vad_title">Skoperta tal-Attività tal-Vuċi (VAD)</string>
    <string name="pref_vad_subtitle">Juża Silero VAD biex jiffiltra s-skiet u l-istorbju fl-isfond qabel it-traskrizzjoni. Iddiżattivah biss jekk il-VAD qed jaqta\' l-bidu tat-taħdit tiegħek jew qed jagħti riżultati vojta.</string>
    <string name="pref_postprocessing_title">Post-Proċessar tat-Traskrizzjoni</string>
    <string name="pref_postprocessing_subtitle">Ineħħi l-kliem ta\' mili (uh, um, hmm), jiġbor it-tlagħlim u jnaddaf frażijiet ripetuti li l-mudell kultant jallucina. Iddiżattivah biex tirċievi l-output eżatt u mhux ipproċessat tal-mudell — utli biex tiddijanjostika jekk it-tindif huwiex responsabbli għal kliem li jintilef jew jinbidel.</string>
    <string name="pref_postprocessing_disabled_raw">Diżattivat (output mhux ipproċessat)</string>
    <string name="pref_keep_loaded_title">Żomm il-Mudell Mgħobbi</string>
    <string name="pref_keep_loaded_subtitle">Iżomm il-mudell tat-taħdit fil-memorja waqt li tuża tastiera oħra, biex id-dettatura tkun lesta mill-ewwel meta terġa\' taqleb lura minflok ma jerġa\' jitgħabba l-mudell. Iħaddem servizz fil-quddiem b\'notifika permanenti u juża madwar 700 MB ta\' RAM.</string>
    <string name="pref_diagnostics_title">Dijanjostika tal-Pipeline</string>
    <string name="pref_diagnostics_subtitle">Juri badge dirett fuq it-tastiera b\'counters għat-tqaċċit tat-tieqa, l-irkupri tal-allinjament u l-passi vojta mormija. Utli biex jiġu dijanjostikati problemi fil-pipeline; mitfi b\'mod awtomatiku.</string>
    <string name="pref_diagnostics_visible">Viżibbli</string>
    <string name="pref_diagnostics_hidden">Moħbi</string>

    <!-- Model screen -->
    <string name="model_screen_title">Mudelli tar-Rikonoxximent tat-Taħdit</string>
    <string name="model_screen_subtitle">Installa mudell u agħfas “Issettja bħala Attiv” biex tużah għat-traskrizzjoni. Mudell wieħed biss jitgħabba kull darba. Parakeetype m\'għandhiex aċċess għall-internet: tniżżel il-fajl tal-mudell fil-browser u timportah hawn.</string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Mudell attiv</string>
    <string name="dialog_delete_title">Ikkonferma t-Tħassir</string>
    <string name="dialog_delete_message">Żgur li trid tħassar dan il-mudell? Din l-azzjoni ma tistax titreġġa\' lura.</string>
    <string name="model_install_explanation">1. Niżżel il-fajl tal-mudell (~%d MB, arkivju ZIP wieħed) fil-browser.\n2. Agħfas “Importa l-fajl tal-mudell” u agħżel l-arkivju mniżżel.\nWara l-importazzjoni tista\' tħassar l-arkivju mill-folder tad-Downloads.</string>
    <string name="action_download_in_browser">Niżżel fil-browser</string>
    <string name="action_import_model_file">Importa l-fajl tal-mudell</string>
    <string name="model_importing_format">Qed jiġi importat… %d%%</string>
    <string name="model_no_browser">Ma nstab l-ebda browser biex tinfetaħ il-link tat-tniżżil.</string>
    <string name="model_import_success">Il-mudell ġie importat. Issa tista\' tħassar l-arkivju mniżżel.</string>

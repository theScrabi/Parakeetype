    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Tryb wyzwalania</string>
    <string name="pref_trigger_mode_subtitle">Jak rozpoczynać i kończyć nagrywanie głosu.</string>
    <string name="pref_trigger_hold">Przytrzymaj, aby mówić</string>
    <string name="pref_trigger_tap_toggle">Dotknij, aby przełączyć</string>
    <string name="pref_immediate_mode_title">Tryb natychmiastowy</string>
    <string name="pref_immediate_mode_subtitle">Zaczyna słuchać, gdy tylko przełączysz się na Parakeetype, np. klawiszem mikrofonu innej klawiatury. Gdy przestaniesz mówić, tekst zostanie wpisany i nastąpi powrót do tamtej klawiatury.</string>
    <string name="pref_delete_title">Przycisk usuwania</string>
    <string name="pref_delete_subtitle">Co usuwa przycisk kosza na klawiaturze. „Ostatnie zdanie” usuwa tylko ostatnie zdanie przed kursorem, dzięki czemu długi dokument nigdy nie zostanie przypadkowo wymazany.</string>
    <string name="pref_delete_all">Cały tekst</string>
    <string name="pref_delete_last_sentence">Ostatnie zdanie</string>
    <string name="pref_position_title">Położenie klawiatury</string>
    <string name="pref_position_subtitle">Gdzie znajdują się elementy sterujące klawiatury. Po lewej lub prawej stronie są w zasięgu jednego kciuka – przydatne w orientacji poziomej, dla osób leworęcznych i na tabletach.</string>
    <string name="pref_position_portrait">W orientacji pionowej</string>
    <string name="pref_position_landscape">W orientacji poziomej</string>
    <string name="pref_position_left">Po lewej</string>
    <string name="pref_position_center">Na środku</string>
    <string name="pref_position_right">Po prawej</string>
    <string name="pref_vad_title">Wykrywanie aktywności głosowej (VAD)</string>
    <string name="pref_vad_subtitle">Używa Silero VAD do odfiltrowania ciszy i szumów tła przed transkrypcją. Wyłącz tylko wtedy, gdy VAD obcina początek wypowiedzi lub daje puste wyniki.</string>
    <string name="pref_postprocessing_title">Przetwarzanie końcowe transkrypcji</string>
    <string name="pref_postprocessing_subtitle">Usuwa słowa wypełniające (yyy, eee, hmm), scala zająknięcia i usuwa powtórzone frazy, które model czasem halucynuje. Wyłącz, aby otrzymywać dokładny, surowy wynik modelu – przydatne do sprawdzenia, czy to czyszczenie odpowiada za pominięte lub zmienione słowa.</string>
    <string name="pref_postprocessing_disabled_raw">Wyłączone (surowy wynik)</string>
    <string name="pref_keep_loaded_title">Utrzymuj model w pamięci</string>
    <string name="pref_keep_loaded_subtitle">Utrzymuje model mowy w pamięci, gdy używasz innej klawiatury, dzięki czemu dyktowanie jest od razu gotowe po powrocie, bez ponownego wczytywania modelu. Działa jako usługa na pierwszym planie ze stałym powiadomieniem i zajmuje około 700 MB pamięci RAM.</string>
    <string name="pref_diagnostics_title">Diagnostyka potoku</string>
    <string name="pref_diagnostics_subtitle">Wyświetla na klawiaturze plakietkę na żywo z licznikami przycięć okna, odzyskań wyrównania i odrzuconych pustych kroków. Przydatne do diagnozowania problemów z potokiem; domyślnie ukryte.</string>
    <string name="pref_diagnostics_visible">Widoczna</string>
    <string name="pref_diagnostics_hidden">Ukryta</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modele rozpoznawania mowy</string>
    <string name="model_screen_subtitle">Zainstaluj model i dotknij „Ustaw jako aktywny”, aby używać go do transkrypcji. Jednocześnie wczytany jest tylko jeden model. Parakeetype nie ma dostępu do internetu: plik modelu pobierasz w przeglądarce i importujesz tutaj.</string>

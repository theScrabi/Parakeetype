    <!-- Preferences · microphone section -->
    <string name="pref_mic_title">Mikrofon</string>
    <string name="pref_mic_subtitle">Skalibruj, aby wybrać najwyraźniejszy mikrofon dla krótkich słów, takich jak „Thanks”.</string>
    <string name="pref_mic_calibrate">Kalibruj mikrofony</string>
    <string name="pref_raw_mic_title">Surowy mikrofon (bez usuwania echa)</string>
    <string name="pref_raw_mic_subtitle">Pomija systemowe usuwanie echa i tłumienie szumów. Włącz, gdy transkrybujesz dźwięk odtwarzany z głośnika tego urządzenia (np. pocztę głosową na głośniku) – przy domyślnym źródle sygnał głośnika jest usuwany z mikrofonu i transkrybowany jako cisza. W głośnych pomieszczeniach nagranie jest nieco mniej czyste.</string>

    <!-- Microphone calibration -->
    <string name="calib_subtitle">Wybierz mikrofon, który najwyraźniej rejestruje wysokie częstotliwości. Model mowy potrzebuje ich, aby rozpoznawać krótkie słowa, takie jak „Thanks”.</string>
    <string name="calib_instructions">Poczekaj na czerwony wskaźnik przy każdym mikrofonie, a następnie wyraźnie powiedz po angielsku „thanks”. Najwyraźniejszy mikrofon zostanie wybrany automatycznie.</string>

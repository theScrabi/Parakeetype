    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Udløsertilstand</string>
    <string name="pref_trigger_mode_subtitle">Hvordan taleoptagelsen startes og stoppes.</string>
    <string name="pref_trigger_hold">Hold for at tale</string>
    <string name="pref_trigger_tap_toggle">Tryk for at slå til/fra</string>
    <string name="pref_instant_mode_title">Øjeblikkelig tilstand</string>
    <string name="pref_instant_mode_subtitle">Begynder at lytte, så snart du skifter til Parakeetype, f.eks. med mikrofontasten på et andet tastatur. Når du holder op med at tale, bliver teksten skrevet, og du skiftes tilbage til det tastatur. Tryk på taleknappen under sessionen for at blive i Parakeetype.</string>
    <string name="pref_delete_title">Sletknap</string>
    <string name="pref_delete_subtitle">Hvad papirkurvsknappen på tastaturet sletter. \"Sidste sætning\" fjerner kun den seneste sætning før markøren, så et langt dokument aldrig slettes ved et uheld.</string>
    <string name="pref_delete_all">Al tekst</string>
    <string name="pref_delete_last_sentence">Sidste sætning</string>
    <string name="pref_position_title">Tastaturets placering</string>
    <string name="pref_position_subtitle">Hvor tastaturets knapper sidder. Til venstre eller højre er de inden for rækkevidde af én tommelfinger – praktisk i liggende format, for venstrehåndede og på tablets.</string>
    <string name="pref_position_portrait">I stående format</string>
    <string name="pref_position_landscape">I liggende format</string>
    <string name="pref_position_left">Venstre</string>
    <string name="pref_position_center">Midten</string>
    <string name="pref_position_right">Højre</string>
    <string name="pref_vad_title">Registrering af taleaktivitet (VAD)</string>
    <string name="pref_vad_subtitle">Bruger Silero VAD til at filtrere stilhed og baggrundsstøj fra før transskriptionen. Deaktiver kun, hvis VAD skærer begyndelsen af din tale af eller giver tomme resultater.</string>
    <string name="pref_postprocessing_title">Efterbehandling af transskription</string>
    <string name="pref_postprocessing_subtitle">Fjerner fyldord (øh, øhm, hmm), samler stammen og rydder op i gentagne sætninger, som modellen nogle gange hallucinerer. Deaktiver for at få modellens præcise, rå output - nyttigt til at finde ud af, om oprydningen er skyld i manglende eller ændrede ord.</string>
    <string name="pref_postprocessing_disabled_raw">Deaktiveret (råt output)</string>
    <string name="pref_keep_loaded_title">Hold modellen indlæst</string>
    <string name="pref_keep_loaded_subtitle">Holder talemodellen i hukommelsen, mens du bruger et andet tastatur, så diktering er klar med det samme, når du skifter tilbage, i stedet for at modellen skal indlæses igen. Kører en forgrundstjeneste med en vedvarende notifikation og optager ca. 700 MB RAM.</string>
    <string name="pref_diagnostics_title">Pipelinediagnosticering</string>
    <string name="pref_diagnostics_subtitle">Viser et live-badge på tastaturet med tællere for vinduesbeskæringer, gendannelser af justering og kasserede tomme skridt. Nyttigt til at diagnosticere pipelineproblemer; skjult som standard.</string>
    <string name="pref_diagnostics_visible">Synlig</string>
    <string name="pref_diagnostics_hidden">Skjult</string>

    <!-- Model screen -->
    <string name="model_screen_title">Talegenkendelsesmodeller</string>
    <string name="model_screen_subtitle">Installer en model, og tryk på \"Angiv som aktiv\" for at bruge den til transskription. Der indlæses kun én model ad gangen. Parakeetype har ingen internetadgang: Du downloader modelfilen i din browser og importerer den her.</string>

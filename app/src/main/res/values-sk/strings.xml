    <!-- Preferences · microphone section -->
    <string name="pref_mic_title">Mikrofón</string>
    <string name="pref_mic_subtitle">Kalibráciou vyberiete najzreteľnejší mikrofón pre krátke slová ako „Thanks“.</string>
    <string name="pref_mic_calibrate">Kalibrovať mikrofóny</string>
    <string name="pref_raw_mic_title">Nespracovaný mikrofón (bez potlačenia ozveny)</string>
    <string name="pref_raw_mic_subtitle">Obchádza systémové potlačenie ozveny a šumu. Zapnite, ak prepisujete zvuk prehrávaný z vlastného reproduktora zariadenia (napr. hlasovú schránku cez hlasitý odposluch) – pri predvolenom zdroji sa signál reproduktora z mikrofónu odstráni a prepíše sa ako ticho. V hlučných miestnostiach je záznam o niečo menej čistý.</string>

    <!-- Microphone calibration -->
    <string name="calib_subtitle">Vyberte mikrofón, ktorý najzreteľnejšie zachytí vysoké frekvencie. Model reči ich potrebuje na rozpoznanie krátkych slov ako „Thanks“.</string>
    <string name="calib_instructions">Pri každom mikrofóne počkajte na červený indikátor a potom zreteľne povedzte po anglicky „thanks“. Najzreteľnejší mikrofón sa vyberie automaticky.</string>

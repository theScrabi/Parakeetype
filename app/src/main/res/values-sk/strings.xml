    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Režim spúšťania</string>
    <string name="pref_trigger_mode_subtitle">Ako spustiť a zastaviť hlasové nahrávanie.</string>
    <string name="pref_trigger_hold">Podržať a hovoriť</string>
    <string name="pref_trigger_tap_toggle">Prepnúť klepnutím</string>
    <string name="pref_instant_mode_title">Okamžitý režim</string>
    <string name="pref_instant_mode_subtitle">Začne počúvať hneď, ako prepnete na Parakeetype, napr. klávesom mikrofónu inej klávesnice. Keď prestanete hovoriť, text sa zapíše a klávesnica sa prepne späť na predchádzajúcu. Ak chcete zostať v Parakeetype, počas relácie sa dotknite tlačidla hovorenia.</string>
    <string name="pref_delete_title">Tlačidlo odstránenia</string>
    <string name="pref_delete_subtitle">Čo odstráni tlačidlo koša na klávesnici. „Posledná veta“ odstráni iba poslednú vetu pred kurzorom, takže dlhý dokument nikdy omylom nevymažete.</string>
    <string name="pref_delete_all">Celý text</string>
    <string name="pref_delete_last_sentence">Posledná veta</string>
    <string name="pref_position_title">Umiestnenie klávesnice</string>
    <string name="pref_position_subtitle">Kde sa nachádzajú ovládacie prvky klávesnice. Vľavo alebo vpravo sú na dosah jedného palca – užitočné na šírku, pre ľavákov a na tabletoch.</string>
    <string name="pref_position_portrait">Na výšku</string>
    <string name="pref_position_landscape">Na šírku</string>
    <string name="pref_position_left">Vľavo</string>
    <string name="pref_position_center">V strede</string>
    <string name="pref_position_right">Vpravo</string>
    <string name="pref_vad_title">Detekcia hlasovej aktivity (VAD)</string>
    <string name="pref_vad_subtitle">Pomocou Silero VAD odfiltruje pred prepisom ticho a hluk v pozadí. Vypnite iba vtedy, ak VAD odrezáva začiatok vašej reči alebo vracia prázdne výsledky.</string>
    <string name="pref_postprocessing_title">Následné spracovanie prepisu</string>
    <string name="pref_postprocessing_subtitle">Odstraňuje výplňové slová (ehm, hm, no), zlučuje zajakávanie a čistí opakované frázy, ktoré si model niekedy vymýšľa. Vypnite, ak chcete dostávať presný nespracovaný výstup modelu – užitočné na zistenie, či čistenie nespôsobuje vynechané alebo zmenené slová.</string>
    <string name="pref_postprocessing_disabled_raw">Vypnuté (nespracovaný výstup)</string>
    <string name="pref_keep_loaded_title">Ponechať model načítaný</string>
    <string name="pref_keep_loaded_subtitle">Ponechá model reči v pamäti, kým používate inú klávesnicu, takže diktovanie je po prepnutí späť okamžite pripravené a model sa nemusí znova načítavať. Beží ako služba v popredí s trvalým upozornením a zaberá približne 700 MB pamäte RAM.</string>
    <string name="pref_diagnostics_title">Diagnostika spracovania</string>
    <string name="pref_diagnostics_subtitle">Zobrazuje na klávesnici živý odznak s počítadlami skrátení okna, obnovení zarovnania a zahodených prázdnych krokov. Užitočné na diagnostiku problémov so spracovaním; predvolene skryté.</string>
    <string name="pref_diagnostics_visible">Zobrazené</string>
    <string name="pref_diagnostics_hidden">Skryté</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modely rozpoznávania reči</string>
    <string name="model_screen_subtitle">Nainštalujte model a klepnutím na „Nastaviť ako aktívny“ ho použite na prepis. Naraz je načítaný iba jeden model. Parakeetype nemá prístup na internet: súbor modelu stiahnete v prehliadači a importujete ho sem.</string>

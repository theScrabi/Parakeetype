<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (ignored from API 31, see data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Crash reports may contain dictated text; never back them up. -->
    <exclude domain="file" path="crash/"/>
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Crash reports may contain dictated text; never back them up. -->
        <exclude domain="file" path="crash/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="crash/"/>
    </device-transfer>
</data-extraction-rules>

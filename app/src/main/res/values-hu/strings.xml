    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Indítási mód</string>
    <string name="pref_trigger_mode_subtitle">A hangfelvétel indításának és leállításának módja.</string>
    <string name="pref_trigger_hold">Nyomva tartás beszédhez</string>
    <string name="pref_trigger_tap_toggle">Koppintás a váltáshoz</string>
    <string name="pref_immediate_mode_title">Azonnali mód</string>
    <string name="pref_immediate_mode_subtitle">Azonnal elkezd figyelni, amint átvált a Parakeetype-ra, pl. egy másik billentyűzet mikrofon gombjával. Amikor abbahagyja a beszédet, a szöveg bekerül, és visszavált arra a billentyűzetre.</string>
    <string name="pref_delete_title">Törlés gomb</string>
    <string name="pref_delete_subtitle">Mit töröl a billentyűzet kuka gombja. Az „Utolsó mondat” csak a kurzor előtti legutóbbi mondatot távolítja el, így egy hosszú dokumentum sosem törlődik véletlenül.</string>
    <string name="pref_delete_all">Teljes szöveg</string>
    <string name="pref_delete_last_sentence">Utolsó mondat</string>
    <string name="pref_position_title">Billentyűzet helyzete</string>
    <string name="pref_position_subtitle">Hol helyezkednek el a billentyűzet kezelőelemei. Bal vagy jobb oldalon egy hüvelykujjal is elérhetők – hasznos fekvő tájolásban, balkezeseknek és táblagépeken.</string>
    <string name="pref_position_portrait">Álló tájolásban</string>
    <string name="pref_position_landscape">Fekvő tájolásban</string>
    <string name="pref_position_left">Bal</string>
    <string name="pref_position_center">Közép</string>
    <string name="pref_position_right">Jobb</string>
    <string name="pref_vad_title">Hangaktivitás-érzékelés (VAD)</string>
    <string name="pref_vad_subtitle">A Silero VAD segítségével kiszűri a csendet és a háttérzajt az átírás előtt. Csak akkor kapcsolja ki, ha a VAD levágja a beszéd elejét, vagy üres eredményt ad.</string>
    <string name="pref_postprocessing_title">Átirat utófeldolgozása</string>
    <string name="pref_postprocessing_subtitle">Eltávolítja a töltelékszavakat (ö, hm, hmm), összevonja a dadogást, és kitisztítja a modell által néha hallucinált ismétlődő kifejezéseket. Kapcsolja ki, ha a modell pontos, nyers kimenetét szeretné kapni – hasznos annak megállapításához, hogy a tisztítás okozza-e a kimaradt vagy megváltozott szavakat.</string>
    <string name="pref_postprocessing_disabled_raw">Kikapcsolva (nyers kimenet)</string>
    <string name="pref_keep_loaded_title">Modell betöltve tartása</string>
    <string name="pref_keep_loaded_subtitle">A beszédmodellt a memóriában tartja, amíg másik billentyűzetet használ, így visszaváltáskor a diktálás azonnal elérhető, és nem kell újra betölteni a modellt. Előtérben futó szolgáltatásként, állandó értesítéssel működik, és körülbelül 700 MB RAM-ot foglal.</string>
    <string name="pref_diagnostics_title">Feldolgozási diagnosztika</string>
    <string name="pref_diagnostics_subtitle">Élő jelvényt jelenít meg a billentyűzeten, amely számolja az ablakvágásokat, az igazítás-helyreállításokat és az eldobott üres lépéseket. Hasznos a feldolgozási hibák diagnosztizálásához; alapértelmezés szerint ki van kapcsolva.</string>
    <string name="pref_diagnostics_visible">Látható</string>
    <string name="pref_diagnostics_hidden">Rejtett</string>

    <!-- Model screen -->
    <string name="model_screen_title">Beszédfelismerő modellek</string>
    <string name="model_screen_subtitle">Telepítsen egy modellt, majd koppintson a „Beállítás aktívként” gombra, hogy azt használja az átíráshoz. Egyszerre csak egy modell van betöltve. A Parakeetype nem fér hozzá az internethez: a modellfájlt a böngészőben töltheti le, majd itt importálhatja.</string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktív modell</string>
    <string name="dialog_delete_title">Törlés megerősítése</string>
    <string name="dialog_delete_message">Biztosan törli ezt a modellt? Ez a művelet nem vonható vissza.</string>
    <string name="model_install_explanation">1. Töltse le a modellfájlt (~%d MB, egy ZIP-archívum) a böngészőben.\n2. Koppintson a „Modellfájl importálása” gombra, és válassza ki a letöltött archívumot.\nAz importálás után törölheti az archívumot a Letöltések mappából.</string>

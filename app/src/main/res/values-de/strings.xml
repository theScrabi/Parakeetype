    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Auslösemodus</string>
    <string name="pref_trigger_mode_subtitle">Wie die Sprachaufnahme gestartet und gestoppt wird.</string>
    <string name="pref_trigger_hold">Halten zum Sprechen</string>
    <string name="pref_trigger_tap_toggle">Tippen zum Umschalten</string>
    <string name="pref_delete_title">Löschen-Button</string>
    <string name="pref_delete_subtitle">Was der Müll-Button auf der Tastatur löscht. \"Letzter Satz\" entfernt nur den
        letzten Satz vor dem Cursor, damit ein langes Dokument nie versehentlich gelöscht wird.
    </string>
    <string name="pref_delete_all">Gesamter Text</string>
    <string name="pref_delete_last_sentence">Letzter Satz</string>
    <string name="pref_position_title">Tastaturposition</string>
    <string name="pref_position_subtitle">Wo die Tastatur-Bedienelemente liegen. Links oder rechts bleiben sie mit einem
        Daumen erreichbar – praktisch im Querformat, für Linkshänder und auf Tablets.
    </string>
    <string name="pref_position_portrait">Im Hochformat</string>
    <string name="pref_position_landscape">Im Querformat</string>
    <string name="pref_position_left">Links</string>
    <string name="pref_position_center">Mitte</string>
    <string name="pref_position_right">Rechts</string>
    <string name="pref_vad_title">Sprachaktivitätserkennung (VAD)</string>
    <string name="pref_vad_subtitle">Verwendet Silero VAD, um Stille und Hintergrundgeräusche vor der Transkription
        herauszufiltern. Nur deaktivieren, wenn VAD den Anfang deiner Sprache abschneidet oder leere Ergebnisse erzeugt.
    </string>
    <string name="pref_postprocessing_title">Transkript-Nachbearbeitung</string>
    <string name="pref_postprocessing_subtitle">Entfernt Füllwörter (äh, ähm, hmm), reduziert Stotter und bereinigt
        wiederholte Phrasen. Deaktivieren, um die direkte Modellausgabe zu erhalten - nützlich zum Diagnostizieren, ob
        die Bereinigung Wörter weglässt oder verändert.
    </string>
    <string name="pref_postprocessing_disabled_raw">Deaktiviert (Rohausgabe)</string>
    <string name="pref_keep_loaded_title">Modell geladen halten</string>
    <string name="pref_keep_loaded_subtitle">Hält das Sprachmodell im Speicher, während du eine andere Tastatur
        verwendest, damit die Spracheingabe beim Zurückwechseln sofort bereit ist, statt das Modell neu zu laden. Läuft als
        Vordergrunddienst mit dauerhafter Benachrichtigung und belegt etwa 700 MB Arbeitsspeicher.
    </string>
    <string name="pref_diagnostics_title">Pipeline-Diagnose</string>
    <string name="pref_diagnostics_subtitle">Zeigt ein Live-Badge auf der Tastatur mit Zählern für Fensterkürzungen,
        Ausrichtungswiederherstellungen und verworfene leere Schritte. Nützlich zur Diagnose von Pipeline-Problemen;
        standardmäßig ausgeblendet.
    </string>
    <string name="pref_diagnostics_visible">Sichtbar</string>
    <string name="pref_diagnostics_hidden">Ausgeblendet</string>

    <!-- Model screen -->
    <string name="model_screen_title">Spracherkennungsmodelle</string>
    <string name="model_screen_subtitle">Installiere ein Modell und tippe auf „Als aktiv festlegen“, um es für die
        Transkription zu verwenden. Es wird immer nur ein Modell geladen. Parakeetype hat keinen Internetzugriff: Du lädst
        die Modelldatei im Browser herunter und importierst sie hier.
    </string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktives Modell</string>
    <string name="dialog_delete_title">Löschen bestätigen</string>
    <string name="dialog_delete_message">Dieses Modell wirklich löschen? Diese Aktion kann nicht rückgängig gemacht
        werden.
    </string>
    <string name="model_install_explanation">1. Lade die Modelldatei (~%d MB, ein ZIP-Archiv) im Browser herunter.\n2. Tippe auf „Modelldatei importieren“ und wähle das heruntergeladene Archiv.\nNach dem Import kannst du das Archiv aus deinem Download-Ordner löschen.</string>

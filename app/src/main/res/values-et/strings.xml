    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Käivitusrežiim</string>
    <string name="pref_trigger_mode_subtitle">Kuidas häälsalvestust alustatakse ja peatatakse.</string>
    <string name="pref_trigger_hold">Hoidke all ja rääkige</string>
    <string name="pref_trigger_tap_toggle">Puudutage sisse/välja</string>
    <string name="pref_immediate_mode_title">Kohene režiim</string>
    <string name="pref_immediate_mode_subtitle">Hakkab kuulama kohe, kui lülitute ümber klaviatuurile Parakeetype, nt teise klaviatuuri mikrofoniklahviga. Kui lõpetate rääkimise, sisestatakse tekst ja lülitutakse tagasi sellele klaviatuurile.</string>
    <string name="pref_delete_title">Kustutamisnupp</string>
    <string name="pref_delete_subtitle">Mida klaviatuuri prügikastinupp kustutab. „Viimane lause“ eemaldab ainult kursori ees oleva viimase lause, nii et pikka dokumenti ei kustutata kunagi kogemata.</string>
    <string name="pref_delete_all">Kogu tekst</string>
    <string name="pref_delete_last_sentence">Viimane lause</string>
    <string name="pref_position_title">Klaviatuuri asukoht</string>
    <string name="pref_position_subtitle">Kus klaviatuuri nupud asuvad. Vasakul või paremal on need ühe pöidla ulatuses – kasulik horisontaalpaigutuses, vasakukäelistele ja tahvelarvutites.</string>
    <string name="pref_position_portrait">Vertikaalpaigutuses</string>
    <string name="pref_position_landscape">Horisontaalpaigutuses</string>
    <string name="pref_position_left">Vasakul</string>
    <string name="pref_position_center">Keskel</string>
    <string name="pref_position_right">Paremal</string>
    <string name="pref_vad_title">Kõnetegevuse tuvastus (VAD)</string>
    <string name="pref_vad_subtitle">Kasutab Silero VAD-i, et vaikus ja taustamüra enne transkribeerimist välja filtreerida. Keelake see ainult siis, kui VAD lõikab teie kõne alguse ära või annab tühje tulemusi.</string>
    <string name="pref_postprocessing_title">Transkriptsiooni järeltöötlus</string>
    <string name="pref_postprocessing_subtitle">Eemaldab täitesõnad (ee, õõ, hmm), ühendab kogelemise ja puhastab korduvad fraasid, mida mudel vahel hallutsineerib. Keelake, et saada mudeli täpne töötlemata väljund - kasulik, et selgitada, kas puhastamine põhjustab sõnade kadumist või muutumist.</string>
    <string name="pref_postprocessing_disabled_raw">Keelatud (töötlemata väljund)</string>
    <string name="pref_keep_loaded_title">Hoia mudel laaditud</string>
    <string name="pref_keep_loaded_subtitle">Hoiab kõnemudelit mälus, kui kasutate teist klaviatuuri, nii et dikteerimine on tagasi lülitudes kohe valmis ja mudelit ei pea uuesti laadima. Käitab püsiva märguandega esiplaanil olevat teenust ja hoiab kasutuses umbes 700 MB muutmälu.</string>
    <string name="pref_diagnostics_title">Konveieri diagnostika</string>
    <string name="pref_diagnostics_subtitle">Kuvab klaviatuuril reaalajas märgi, millel on loendurid akna kärpimiste, joonduse taastamiste ja kõrvale jäetud tühjade sammude kohta. Kasulik konveieri probleemide diagnoosimiseks; vaikimisi peidetud.</string>
    <string name="pref_diagnostics_visible">Nähtav</string>
    <string name="pref_diagnostics_hidden">Peidetud</string>

    <!-- Model screen -->
    <string name="model_screen_title">Kõnetuvastusmudelid</string>
    <string name="model_screen_subtitle">Installige mudel ja puudutage valikut „Määra aktiivseks“, et seda transkribeerimiseks kasutada. Korraga laaditakse ainult üks mudel. Rakendusel Parakeetype pole internetiühendust: laadite mudelifaili brauseris alla ja impordite selle siin.</string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktiivne mudel</string>
    <string name="dialog_delete_title">Kustutamise kinnitamine</string>
    <string name="dialog_delete_message">Kas soovite kindlasti selle mudeli kustutada? Seda toimingut ei saa tagasi võtta.</string>
    <string name="model_install_explanation">1. Laadige mudelifail (~%d MB, üks ZIP-arhiiv) brauseris alla.\n2. Puudutage valikut „Impordi mudelifail“ ja valige allalaaditud arhiiv.\nPärast importimist võite arhiivi kaustast Allalaadimised kustutada.</string>

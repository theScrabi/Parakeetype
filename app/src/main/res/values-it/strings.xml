    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Modalità di attivazione</string>
    <string name="pref_trigger_mode_subtitle">Come avviare e interrompere la registrazione vocale.</string>
    <string name="pref_trigger_hold">Tieni premuto per parlare</string>
    <string name="pref_trigger_tap_toggle">Tocca per attivare/disattivare</string>
    <string name="pref_instant_mode_title">Modalità istantanea</string>
    <string name="pref_instant_mode_subtitle">Inizia ad ascoltare non appena passi a Parakeetype, ad es. con il tasto microfono di un\'altra tastiera. Quando smetti di parlare, il testo viene digitato e torni a quella tastiera. Tocca il pulsante di dettatura durante la sessione per restare su Parakeetype.</string>
    <string name="pref_delete_title">Pulsante Elimina</string>
    <string name="pref_delete_subtitle">Cosa elimina il pulsante cestino della tastiera. «Ultima frase» rimuove solo la frase più recente prima del cursore, così un documento lungo non viene mai cancellato per errore.</string>
    <string name="pref_delete_all">Tutto il testo</string>
    <string name="pref_delete_last_sentence">Ultima frase</string>
    <string name="pref_position_title">Posizione della tastiera</string>
    <string name="pref_position_subtitle">Dove si trovano i comandi della tastiera. A sinistra o a destra restano a portata di un solo pollice – utile in orizzontale, per i mancini e sui tablet.</string>
    <string name="pref_position_portrait">In verticale</string>
    <string name="pref_position_landscape">In orizzontale</string>
    <string name="pref_position_left">Sinistra</string>
    <string name="pref_position_center">Centro</string>
    <string name="pref_position_right">Destra</string>
    <string name="pref_vad_title">Rilevamento dell\'attività vocale (VAD)</string>
    <string name="pref_vad_subtitle">Usa Silero VAD per filtrare silenzio e rumori di fondo prima della trascrizione. Disattivalo solo se il VAD taglia l\'inizio del tuo parlato o produce risultati vuoti.</string>
    <string name="pref_postprocessing_title">Post-elaborazione della trascrizione</string>
    <string name="pref_postprocessing_subtitle">Rimuove le parole riempitive (ehm, uhm, mmh), riduce le balbuzie e ripulisce le frasi ripetute che il modello a volte allucina. Disattivala per ricevere l\'output grezzo esatto del modello – utile per capire se la pulizia è responsabile di parole mancanti o alterate.</string>
    <string name="pref_postprocessing_disabled_raw">Disattivata (output grezzo)</string>
    <string name="pref_keep_loaded_title">Mantieni il modello caricato</string>
    <string name="pref_keep_loaded_subtitle">Mantiene il modello vocale in memoria mentre usi un\'altra tastiera, così la dettatura è subito pronta quando torni, senza ricaricare il modello. Esegue un servizio in primo piano con una notifica persistente e occupa circa 700 MB di RAM.</string>
    <string name="pref_diagnostics_title">Diagnostica della pipeline</string>
    <string name="pref_diagnostics_subtitle">Mostra un badge in tempo reale sulla tastiera con i contatori di tagli della finestra, recuperi di allineamento e passi vuoti scartati. Utile per diagnosticare problemi della pipeline; nascosto per impostazione predefinita.</string>
    <string name="pref_diagnostics_visible">Visibile</string>
    <string name="pref_diagnostics_hidden">Nascosto</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modelli di riconoscimento vocale</string>
    <string name="model_screen_subtitle">Installa un modello e tocca «Imposta come attivo» per usarlo per la trascrizione. Viene caricato un solo modello alla volta. Parakeetype non ha accesso a Internet: scarichi il file del modello nel browser e lo importi qui.</string>

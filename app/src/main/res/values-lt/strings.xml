    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Paleidimo režimas</string>
    <string name="pref_trigger_mode_subtitle">Kaip pradėti ir sustabdyti balso įrašymą.</string>
    <string name="pref_trigger_hold">Laikykite, kad kalbėtumėte</string>
    <string name="pref_trigger_tap_toggle">Palieskite, kad perjungtumėte</string>
    <string name="pref_instant_mode_title">Momentinis režimas</string>
    <string name="pref_instant_mode_subtitle">Pradeda klausytis vos perjungus į Parakeetype, pvz., kitos klaviatūros mikrofono klavišu, ir sustoja, kai nustojate kalbėti. Klaviatūra lieka atidaryta, todėl galite toliau redaguoti arba diktuoti.</string>
    <string name="pref_delete_title">Trynimo mygtukas</string>
    <string name="pref_delete_subtitle">Ką ištrina klaviatūros šiukšliadėžės mygtukas. „Paskutinis sakinys“ pašalina tik paskutinį sakinį prieš žymeklį, kad ilgas dokumentas niekada nebūtų ištrintas netyčia.</string>
    <string name="pref_delete_all">Visas tekstas</string>
    <string name="pref_delete_last_sentence">Paskutinis sakinys</string>
    <string name="pref_position_title">Klaviatūros padėtis</string>
    <string name="pref_position_subtitle">Kur išdėstyti klaviatūros valdikliai. Kairėje arba dešinėje juos galima pasiekti vienu nykščiu – patogu gulsčiame režime, kairiarankiams ir planšetiniuose kompiuteriuose.</string>
    <string name="pref_position_portrait">Stačiame režime</string>
    <string name="pref_position_landscape">Gulsčiame režime</string>
    <string name="pref_position_left">Kairėje</string>
    <string name="pref_position_center">Centre</string>
    <string name="pref_position_right">Dešinėje</string>
    <string name="pref_vad_title">Balso aktyvumo aptikimas (VAD)</string>
    <string name="pref_vad_subtitle">Naudoja Silero VAD, kad prieš transkribuojant būtų išfiltruota tyla ir foninis triukšmas. Išjunkite tik tada, jei VAD nukerpa jūsų kalbos pradžią arba pateikia tuščius rezultatus.</string>
    <string name="pref_postprocessing_title">Transkripcijos papildomas apdorojimas</string>
    <string name="pref_postprocessing_subtitle">Pašalina užpildų žodžius (ė, ėė, hmm), suglaudina mikčiojimą ir išvalo pasikartojančias frazes, kurias modelis kartais haliucinuoja. Išjunkite, kad gautumėte tikslią neapdorotą modelio išvestį – naudinga nustatant, ar dėl valymo praleidžiami ar pakeičiami žodžiai.</string>
    <string name="pref_postprocessing_disabled_raw">Išjungta (neapdorota išvestis)</string>
    <string name="pref_keep_loaded_title">Laikyti modelį įkeltą</string>
    <string name="pref_keep_loaded_subtitle">Laiko kalbos modelį atmintyje, kol naudojate kitą klaviatūrą, kad grįžus diktavimas būtų paruoštas iškart ir nereikėtų iš naujo įkelti modelio. Veikia kaip priekinio plano paslauga su nuolatiniu pranešimu ir naudoja apie 700 MB RAM.</string>
    <string name="pref_diagnostics_title">Konvejerio diagnostika</string>
    <string name="pref_diagnostics_subtitle">Klaviatūroje rodo tiesioginį ženklelį su lango apkarpymų, lygiavimo atkūrimų ir atmestų tuščių žingsnių skaitikliais. Naudinga diagnozuojant konvejerio problemas; pagal numatytuosius nustatymus išjungta.</string>
    <string name="pref_diagnostics_visible">Rodoma</string>
    <string name="pref_diagnostics_hidden">Paslėpta</string>

    <!-- Model screen -->
    <string name="model_screen_title">Kalbos atpažinimo modeliai</string>
    <string name="model_screen_subtitle">Įdiekite modelį ir palieskite „Nustatyti kaip aktyvų“, kad jį naudotumėte transkribavimui. Vienu metu įkeliamas tik vienas modelis. Programa Parakeetype neturi prieigos prie interneto: modelio failą atsisiunčiate naršyklėje ir importuojate čia.</string>

    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Režim spouštění</string>
    <string name="pref_trigger_mode_subtitle">Jak spustit a zastavit hlasové nahrávání.</string>
    <string name="pref_trigger_hold">Podržet a mluvit</string>
    <string name="pref_trigger_tap_toggle">Přepnout klepnutím</string>
    <string name="pref_instant_mode_title">Okamžitý režim</string>
    <string name="pref_instant_mode_subtitle">Začne poslouchat, jakmile přepnete na Parakeetype, např. klávesou mikrofonu jiné klávesnice. Jakmile přestanete mluvit, text se zapíše a přepne se zpět na tuto klávesnici. Dotkněte se během relace tlačítka mluvení, pokud chcete zůstat v Parakeetype.</string>
    <string name="pref_delete_title">Tlačítko mazání</string>
    <string name="pref_delete_subtitle">Co maže tlačítko koše na klávesnici. „Poslední věta“ odstraní jen poslední větu před kurzorem, takže dlouhý dokument nikdy omylem nesmažete.</string>
    <string name="pref_delete_all">Veškerý text</string>
    <string name="pref_delete_last_sentence">Poslední věta</string>
    <string name="pref_position_title">Umístění klávesnice</string>
    <string name="pref_position_subtitle">Kde se nacházejí ovládací prvky klávesnice. Vlevo nebo vpravo jsou na dosah jednoho palce – užitečné na šířku, pro leváky a na tabletech.</string>
    <string name="pref_position_portrait">Na výšku</string>
    <string name="pref_position_landscape">Na šířku</string>
    <string name="pref_position_left">Vlevo</string>
    <string name="pref_position_center">Uprostřed</string>
    <string name="pref_position_right">Vpravo</string>
    <string name="pref_vad_title">Detekce hlasové aktivity (VAD)</string>
    <string name="pref_vad_subtitle">Pomocí Silero VAD odfiltruje před přepisem ticho a hluk v pozadí. Vypínejte jen tehdy, pokud VAD ořezává začátek vaší řeči nebo vrací prázdné výsledky.</string>
    <string name="pref_postprocessing_title">Následné zpracování přepisu</string>
    <string name="pref_postprocessing_subtitle">Odstraňuje výplňová slova (ehm, hm, no), slučuje zadrhávání a čistí opakované fráze, které si model někdy vymýšlí. Vypněte, chcete-li dostávat přesný nezpracovaný výstup modelu – užitečné pro zjištění, zda čištění nezpůsobuje vynechaná nebo změněná slova.</string>
    <string name="pref_postprocessing_disabled_raw">Vypnuto (nezpracovaný výstup)</string>
    <string name="pref_keep_loaded_title">Ponechat model načtený</string>
    <string name="pref_keep_loaded_subtitle">Ponechá model řeči v paměti, zatímco používáte jinou klávesnici, takže diktování je po přepnutí zpět ihned připraveno a model se nemusí znovu načítat. Běží jako služba v popředí s trvalým oznámením a zabírá asi 700 MB paměti RAM.</string>
    <string name="pref_diagnostics_title">Diagnostika zpracování</string>
    <string name="pref_diagnostics_subtitle">Zobrazuje na klávesnici živý odznak s počítadly zkrácení okna, obnovení zarovnání a zahozených prázdných kroků. Užitečné pro diagnostiku problémů se zpracováním; ve výchozím stavu skryto.</string>
    <string name="pref_diagnostics_visible">Zobrazeno</string>
    <string name="pref_diagnostics_hidden">Skryto</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modely rozpoznávání řeči</string>
    <string name="model_screen_subtitle">Nainstalujte model a klepnutím na „Nastavit jako aktivní“ jej použijte pro přepis. Načtený je vždy jen jeden model. Parakeetype nemá přístup k internetu: soubor modelu stáhnete v prohlížeči a importujete ho zde.</string>

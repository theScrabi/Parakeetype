    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Режим запуску</string>
    <string name="pref_trigger_mode_subtitle">Як починати й зупиняти голосовий запис.</string>
    <string name="pref_trigger_hold">Утримувати й говорити</string>
    <string name="pref_trigger_tap_toggle">Вмикати торканням</string>
    <string name="pref_instant_mode_title">Миттєвий режим</string>
    <string name="pref_instant_mode_subtitle">Починає слухати одразу після перемикання на Parakeetype, наприклад клавішею мікрофона іншої клавіатури. Коли ви замовкаєте, текст вводиться й відбувається повернення до тієї клавіатури. Торкніться кнопки запису під час сеансу, щоб залишитися в Parakeetype.</string>
    <string name="pref_delete_title">Кнопка видалення</string>
    <string name="pref_delete_subtitle">Що видаляє кнопка з кошиком на клавіатурі. «Останнє речення» видаляє лише останнє речення перед курсором, тож довгий документ ніколи не буде стерто випадково.</string>
    <string name="pref_delete_all">Весь текст</string>
    <string name="pref_delete_last_sentence">Останнє речення</string>
    <string name="pref_position_title">Розташування клавіатури</string>
    <string name="pref_position_subtitle">Де розміщено елементи керування клавіатури. Ліворуч або праворуч до них легко дотягнутися одним великим пальцем – зручно в альбомній орієнтації, для шульг і на планшетах.</string>
    <string name="pref_position_portrait">У портретній орієнтації</string>
    <string name="pref_position_landscape">В альбомній орієнтації</string>
    <string name="pref_position_left">Ліворуч</string>
    <string name="pref_position_center">По центру</string>
    <string name="pref_position_right">Праворуч</string>
    <string name="pref_vad_title">Виявлення голосової активності (VAD)</string>
    <string name="pref_vad_subtitle">Використовує Silero VAD, щоб відфільтровувати тишу й фоновий шум перед розпізнаванням. Вимикайте, лише якщо VAD обрізає початок вашого мовлення або дає порожні результати.</string>
    <string name="pref_postprocessing_title">Постобробка тексту</string>
    <string name="pref_postprocessing_subtitle">Видаляє слова-паразити (е, ем, хм), прибирає запинки й повторювані фрази, які модель іноді вигадує. Вимкніть, щоб отримувати необроблений вивід моделі – це допомагає зʼясувати, чи не очищення пропускає або змінює слова.</string>
    <string name="pref_postprocessing_disabled_raw">Вимкнено (необроблений вивід)</string>
    <string name="pref_keep_loaded_title">Не вивантажувати модель</string>
    <string name="pref_keep_loaded_subtitle">Зберігає модель розпізнавання мовлення в памʼяті, поки ви користуєтеся іншою клавіатурою, щоб диктування було доступне одразу після повернення, без повторного завантаження моделі. Запускає службу з постійним сповіщенням і займає близько 700 МБ оперативної памʼяті.</string>
    <string name="pref_diagnostics_title">Діагностика конвеєра</string>
    <string name="pref_diagnostics_subtitle">Показує на клавіатурі значок із лічильниками обрізань вікна, відновлень вирівнювання й відкинутих порожніх кроків. Корисно для діагностики проблем конвеєра; за замовчуванням приховано.</string>
    <string name="pref_diagnostics_visible">Показано</string>
    <string name="pref_diagnostics_hidden">Приховано</string>

    <!-- Model screen -->
    <string name="model_screen_title">Моделі розпізнавання мовлення</string>
    <string name="model_screen_subtitle">Встановіть модель і торкніться «Зробити активною», щоб використовувати її для розпізнавання. Одночасно завантажується лише одна модель. Застосунок Parakeetype не має доступу до інтернету: ви завантажуєте файл моделі в браузері й імпортуєте його тут.</string>

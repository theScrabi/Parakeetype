    <string name="model_active_label">Aktiv modell</string>
    <string name="dialog_delete_title">Bekräfta radering</string>
    <string name="dialog_delete_message">Vill du radera den här modellen? Det går inte att ångra.</string>
    <string name="model_install_explanation">1. Ladda ned modellfilen (~%d MB, ett ZIP-arkiv) i webbläsaren.\n2. Tryck på ”Importera modellfil” och välj det nedladdade arkivet.\nEfter importen kan du radera arkivet från mappen Nedladdningar.</string>

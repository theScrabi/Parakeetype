    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Utlösarläge</string>
    <string name="pref_trigger_mode_subtitle">Hur röstinspelningen startas och stoppas.</string>
    <string name="pref_trigger_hold">Håll ned för att tala</string>
    <string name="pref_trigger_tap_toggle">Tryck för att växla</string>
    <string name="pref_immediate_mode_title">Direktläge</string>
    <string name="pref_immediate_mode_subtitle">Börjar lyssna så fort du byter till Parakeetype, t.ex. med mikrofonknappen på ett annat tangentbord. När du slutar prata skrivs texten in och du kommer tillbaka till det tangentbordet.</string>
    <string name="pref_delete_title">Raderingsknapp</string>
    <string name="pref_delete_subtitle">Vad papperskorgsknappen på tangentbordet raderar. ”Sista meningen” tar bara bort den senaste meningen före markören, så att ett långt dokument aldrig raderas av misstag.</string>
    <string name="pref_delete_all">All text</string>
    <string name="pref_delete_last_sentence">Sista meningen</string>
    <string name="pref_position_title">Tangentbordets placering</string>
    <string name="pref_position_subtitle">Var tangentbordets knappar sitter. Till vänster eller höger når du dem med en tumme – praktiskt i liggande läge, för vänsterhänta och på surfplattor.</string>
    <string name="pref_position_portrait">I stående läge</string>
    <string name="pref_position_landscape">I liggande läge</string>
    <string name="pref_position_left">Vänster</string>
    <string name="pref_position_center">Mitten</string>
    <string name="pref_position_right">Höger</string>
    <string name="pref_vad_title">Röstaktivitetsdetektering (VAD)</string>
    <string name="pref_vad_subtitle">Använder Silero VAD för att filtrera bort tystnad och bakgrundsljud före transkriberingen. Inaktivera bara om VAD klipper bort början av det du säger eller ger tomma resultat.</string>
    <string name="pref_postprocessing_title">Efterbearbetning av transkription</string>
    <string name="pref_postprocessing_subtitle">Tar bort utfyllnadsord (eh, öh, hmm), slår ihop stamningar och rensar upprepade fraser som modellen ibland hallucinerar. Inaktivera för att få modellens exakta, obearbetade utdata - användbart för att ta reda på om rensningen orsakar utelämnade eller ändrade ord.</string>
    <string name="pref_postprocessing_disabled_raw">Inaktiverad (obearbetad utdata)</string>
    <string name="pref_keep_loaded_title">Håll modellen inläst</string>
    <string name="pref_keep_loaded_subtitle">Behåller talmodellen i minnet medan du använder ett annat tangentbord, så att diktering är redo direkt när du byter tillbaka i stället för att modellen läses in på nytt. Kör en förgrundstjänst med en permanent avisering och använder cirka 700 MB RAM.</string>
    <string name="pref_diagnostics_title">Pipelinediagnostik</string>
    <string name="pref_diagnostics_subtitle">Visar en live-bricka på tangentbordet med räknare för fönsterbeskärningar, återställd justering och kasserade tomma steg. Användbart för att felsöka pipelineproblem; dold som standard.</string>
    <string name="pref_diagnostics_visible">Synlig</string>
    <string name="pref_diagnostics_hidden">Dold</string>

    <!-- Model screen -->
    <string name="model_screen_title">Taligenkänningsmodeller</string>
    <string name="model_screen_subtitle">Installera en modell och tryck på ”Ange som aktiv” för att använda den för transkription. Endast en modell läses in åt gången. Parakeetype har ingen internetåtkomst: du laddar ned modellfilen i webbläsaren och importerar den här.</string>

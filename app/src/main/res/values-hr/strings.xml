    <string name="pref_trigger_hold">Držite za govor</string>
    <string name="pref_trigger_tap_toggle">Uključi/isključi dodirom</string>
    <string name="pref_delete_title">Gumb za brisanje</string>
    <string name="pref_delete_subtitle">Što briše gumb s kantom za smeće na tipkovnici. „Zadnja rečenica“ uklanja samo posljednju rečenicu ispred pokazivača, tako da dugačak dokument nikad ne izbrišete slučajno.</string>
    <string name="pref_delete_all">Sav tekst</string>
    <string name="pref_delete_last_sentence">Zadnja rečenica</string>
    <string name="pref_position_title">Položaj tipkovnice</string>
    <string name="pref_position_subtitle">Gdje se nalaze kontrole tipkovnice. Lijevo ili desno ostaju na dohvat jednog palca – korisno u pejzažnom načinu, za ljevake i na tabletima.</string>
    <string name="pref_position_portrait">U portretnom načinu</string>
    <string name="pref_position_landscape">U pejzažnom načinu</string>
    <string name="pref_position_left">Lijevo</string>
    <string name="pref_position_center">Sredina</string>
    <string name="pref_position_right">Desno</string>
    <string name="pref_vad_title">Detekcija glasovne aktivnosti (VAD)</string>
    <string name="pref_vad_subtitle">Upotrebljava Silero VAD za uklanjanje tišine i pozadinske buke prije transkripcije. Onemogućite samo ako VAD odsijeca početak vašeg govora ili daje prazne rezultate.</string>
    <string name="pref_postprocessing_title">Naknadna obrada transkripta</string>
    <string name="pref_postprocessing_subtitle">Uklanja poštapalice (ovaj, hm, mhm), sažima mucanje i čisti ponovljene fraze koje model ponekad izmisli. Onemogućite da biste dobili točan sirovi izlaz modela – korisno za utvrđivanje je li čišćenje odgovorno za izostavljene ili izmijenjene riječi.</string>
    <string name="pref_postprocessing_disabled_raw">Onemogućeno (sirovi izlaz)</string>
    <string name="pref_keep_loaded_title">Zadrži model učitan</string>
    <string name="pref_keep_loaded_subtitle">Zadržava model govora u memoriji dok upotrebljavate drugu tipkovnicu, tako da je diktiranje odmah spremno kad se vratite, bez ponovnog učitavanja modela. Radi kao usluga u prednjem planu sa stalnom obavijesti i zauzima oko 700 MB RAM-a.</string>
    <string name="pref_diagnostics_title">Dijagnostika obrade</string>
    <string name="pref_diagnostics_subtitle">Prikazuje značku uživo na tipkovnici s brojačima skraćivanja prozora, oporavaka poravnanja i odbačenih praznih koraka. Korisno za dijagnosticiranje problema s obradom; prema zadanim postavkama skriveno.</string>
    <string name="pref_diagnostics_visible">Prikazano</string>
    <string name="pref_diagnostics_hidden">Skriveno</string>

    <!-- Model screen -->
    <string name="model_screen_title">Modeli za prepoznavanje govora</string>
    <string name="model_screen_subtitle">Instalirajte model i dodirnite „Postavi kao aktivni“ da biste ga upotrebljavali za transkripciju. Istodobno je učitan samo jedan model. Parakeetype nema pristup internetu: datoteku modela preuzimate u pregledniku i ovdje je uvozite.</string>

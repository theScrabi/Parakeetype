<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
>

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Parakeetype has no network access. onnxruntime-android declares these in its own
         manifest (unused for on-device inference); strip them from the merged manifest.
         Models are downloaded by the user in their browser and imported from storage. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>

    <application
            android:name=".crash.ParakeetypeApplication"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Parakeetype">
        <activity
                android:name=".settings.SettingsActivity"
                android:exported="true"
                android:theme="@style/Theme.Parakeetype">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep-link: parakeetype://settings/permissions, parakeetype://settings/model, etc. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="parakeetype" android:host="settings"/>
            </intent-filter>
        </activity>

        <service
                android:name=".ime.ParakeetypeInputMethodService"
                android:label="@string/ime_name"
                android:permission="android.permission.BIND_INPUT_METHOD"
                android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data
                    android:name="android.view.im"
                    android:resource="@xml/method"/>
        </service>

        <!-- Service that owns the ParakeetEngine lifecycle. Bound by the IME; additionally
             started as a specialUse foreground service when "keep model loaded" is enabled. -->
        <service
                android:name=".inference.InferenceService"
                android:foregroundServiceType="microphone|specialUse"
                android:exported="false">
            <!-- Android 14+ foreground service type justification -->
            <meta-data
                    android:name="android.app.foregroundServiceType.microphone.justification"
                    android:value="Required for real-time speech recognition and transcription."/>
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps the on-device speech recognition model loaded in memory between keyboard sessions (opt-in setting) so dictation is available instantly after switching keyboards."/>
        </service>

        <!-- Speech recognizer for other apps (SpeechRecognizer) and the system voice-input
             setting. Must be exported without a permission so any app can bind it; the
             platform's RecognitionService checks that callers hold RECORD_AUDIO. -->
        <service
                android:name=".recognition.ParakeetypeRecognitionService"
                android:label="@string/app_name"
                android:exported="true"
                tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                    android:name="android.speech"
                    android:resource="@xml/recognition_service"/>
        </service>

        <!-- RecognizerIntent.ACTION_RECOGNIZE_SPEECH: voice input started by other apps. -->
        <activity
                android:name=".recognition.VoiceInputActivity"
                android:label="@string/voice_input_label"
                android:exported="true"
                android:excludeFromRecents="true"
                android:taskAffinity=""
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
                android:theme="@style/Theme.Parakeetype.VoiceInput">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Serves the crash report to the share sheet (CrashReporter.shareIntent). -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.crashlog"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/crash_log_paths"/>
        </provider>

    </application>

</manifest>
